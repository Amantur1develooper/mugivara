# Образец .env — скопируйте в .env и заполните. Сам .env в репозиторий не
# попадает (он в .gitignore), поэтому секреты остаются только на сервере.

# ── Telegram ────────────────────────────────────────────────────────────────
# Токен бота от @BotFather. Лежит ТОЛЬКО здесь: в коде его быть не должно.
TELEGRAM_BOT_TOKEN=

# Чат администратора платформы для служебных сообщений (необязательно)
TELEGRAM_ADMIN_CHAT_ID=

# Секрет вебхука: 32 случайных символа. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
TG_WEBHOOK_SECRET=

# Публичный адрес сайта — по нему собираются ссылки для Telegram
SITE_URL=https://webordo.kg
